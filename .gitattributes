# LF everywhere except Windows batch files. A CRLF shell script fails inside the Linux container.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.onnx binary
*.zip binary
*.sqlite3 binary
