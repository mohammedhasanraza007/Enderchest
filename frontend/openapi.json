{
  "components": {
    "schemas": {
      "BackupItem": {
        "properties": {
          "at": {
            "title": "At",
            "type": "string"
          },
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "item_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Count"
          },
          "kind": {
            "enum": [
              "auto",
              "manual",
              "pre-migration",
              "safety"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "at",
          "bytes",
          "item_count",
          "ok"
        ],
        "title": "BackupItem",
        "type": "object"
      },
      "BackupMade": {
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "folder_hint": {
            "title": "Folder Hint",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "bytes",
          "verified",
          "folder_hint"
        ],
        "title": "BackupMade",
        "type": "object"
      },
      "BackupsView": {
        "properties": {
          "folder_hint": {
            "title": "Folder Hint",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BackupItem"
            },
            "title": "Items",
            "type": "array"
          },
          "last_good": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastGoodBackup"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "stale",
              "failing",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "status",
          "last_good",
          "warnings",
          "items",
          "folder_hint"
        ],
        "title": "BackupsView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "build_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build Date"
          },
          "env": {
            "enum": [
              "live",
              "test"
            ],
            "title": "Env",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "schema_found": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Found"
          },
          "schema_supported": {
            "title": "Schema Supported",
            "type": "integer"
          },
          "status": {
            "enum": [
              "starting",
              "ok",
              "recovery",
              "locked",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "reason",
          "app_version",
          "schema_found",
          "schema_supported",
          "env",
          "build_date"
        ],
        "title": "Health",
        "type": "object"
      },
      "LastGoodBackup": {
        "properties": {
          "at": {
            "title": "At",
            "type": "string"
          },
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "at",
          "bytes"
        ],
        "title": "LastGoodBackup",
        "type": "object"
      },
      "Profile": {
        "properties": {
          "first_run_complete": {
            "title": "First Run Complete",
            "type": "boolean"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "theme": {
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "title": "Theme",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "name",
          "timezone",
          "theme",
          "first_run_complete"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ProfileUpdate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "theme": {
            "anyOf": [
              {
                "enum": [
                  "system",
                  "light",
                  "dark"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "name",
          "timezone"
        ],
        "title": "ProfileUpdate",
        "type": "object"
      },
      "RestoreBody": {
        "properties": {
          "confirm": {
            "const": "RESTORE",
            "title": "Confirm",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "confirm"
        ],
        "title": "RestoreBody",
        "type": "object"
      },
      "SettingsPatch": {
        "additionalProperties": false,
        "description": "Any subset of the settings; a key that is present must carry a real value.\n\nStrict: the string \"yes\" is not a boolean and \"7\" is not a number of days.",
        "properties": {
          "assistant_share_item_text": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assistant Share Item Text"
          },
          "coach_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coach Enabled"
          },
          "gemini_mode": {
            "anyOf": [
              {
                "enum": [
                  "off",
                  "ask",
                  "auto"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gemini Mode"
          },
          "gemini_model": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gemini Model"
          },
          "lead_days": {
            "anyOf": [
              {
                "maximum": 14.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Days"
          },
          "share_images_with_gemini": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share Images With Gemini"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "SettingsView": {
        "properties": {
          "assistant_share_item_text": {
            "title": "Assistant Share Item Text",
            "type": "boolean"
          },
          "coach_enabled": {
            "title": "Coach Enabled",
            "type": "boolean"
          },
          "gemini_mode": {
            "enum": [
              "off",
              "ask",
              "auto"
            ],
            "title": "Gemini Mode",
            "type": "string"
          },
          "gemini_model": {
            "title": "Gemini Model",
            "type": "string"
          },
          "lead_days": {
            "title": "Lead Days",
            "type": "integer"
          },
          "share_images_with_gemini": {
            "title": "Share Images With Gemini",
            "type": "boolean"
          }
        },
        "required": [
          "lead_days",
          "coach_enabled",
          "gemini_mode",
          "gemini_model",
          "share_images_with_gemini",
          "assistant_share_item_text"
        ],
        "title": "SettingsView",
        "type": "object"
      },
      "StartEmptyBody": {
        "properties": {
          "confirm": {
            "const": "START EMPTY",
            "title": "Confirm",
            "type": "string"
          }
        },
        "required": [
          "confirm"
        ],
        "title": "StartEmptyBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Enderchest",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/backups": {
      "get": {
        "operationId": "list_backups_api_v1_backups_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupsView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Backups"
      },
      "post": {
        "operationId": "make_backup_api_v1_backups_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupMade"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Make Backup"
      }
    },
    "/api/v1/boot": {
      "get": {
        "operationId": "boot_api_v1_boot_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Boot Api V1 Boot Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Boot"
      }
    },
    "/api/v1/boot/restore": {
      "post": {
        "operationId": "restore_api_v1_boot_restore_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Restore Api V1 Boot Restore Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Restore"
      }
    },
    "/api/v1/boot/start-empty": {
      "post": {
        "operationId": "start_empty_api_v1_boot_start_empty_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartEmptyBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Start Empty Api V1 Boot Start Empty Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Empty"
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "get_profile_api_v1_profile_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Profile"
      },
      "put": {
        "operationId": "put_profile_api_v1_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Profile"
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "get_settings_api_v1_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Settings"
      },
      "patch": {
        "operationId": "patch_settings_api_v1_settings_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Settings"
      }
    },
    "/health": {
      "get": {
        "description": "Answers 200 whenever the process runs, so Docker never restarts a locked app.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
